rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document: only the owner can read and write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Personal journal entries: only the authenticated owner can read, create, update, delete
      match /journalEntries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Personal chat history: only the owner can read and write
      match /chatSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
